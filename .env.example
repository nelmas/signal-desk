# Copy to .env and fill in. Never commit .env.

# Neon: Dashboard -> your project -> Connect -> copy the connection string.
# Plain postgresql:// URLs are fine; the app switches them to the psycopg driver.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/signal_desk?sslmode=require

# Which folder under backend/topics/ to run.
TOPIC=stocks

# News sources (phase 2).
# SEC requires a name and contact email on every request, e.g. "Jane Doe jane@example.com".
SEC_USER_AGENT=
# Free key, no card: https://finnhub.io/register
FINNHUB_API_KEY=
# Prices (phase 4). Free plan, no card: https://twelvedata.com (US stocks only).
TWELVE_DATA_API_KEY=

# Articles no tracked company was tagged in are deleted after this many days.
UNTAGGED_RETENTION_DAYS=14

# Needed from phase 3 (article tagging). Free key, no card: https://aistudio.google.com
# Do not enable billing on that Google project; then the free tier can never charge you.
LLM_PROVIDER=gemini
LLM_TAG_MODEL=gemini-3.5-flash-lite
LLM_BRIEFING_MODEL=gemini-3.8-flash
LLM_BRIEFING_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Web app (phase 6). Locally the frontend reads this file too; on Vercel set them in the
# project's Environment Variables. The web app should use a read-only database role.
# APP_PASSWORD: your login password (8+ characters).
# SESSION_SECRET: 32+ random characters; changing it logs out every browser.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
SESSION_SECRET=
